# Segredos das edge functions (hoje: send-invite). Copie para
# `supabase/functions/.env.local` (ignorado pelo git via `*.local`), preencha e
# suba para o projeto ONLINE com:
#
#   npx supabase secrets set --env-file supabase/functions/.env.local
#
# NUNCA no `.env.local` da raiz: aquele é do app, e toda `VITE_*` vai para o
# bundle público. Estes ficam só no servidor (ADR 0006). `SUPABASE_URL` e
# `SUPABASE_ANON_KEY` o Supabase injeta sozinho — não precisa pôr.

# API key do Resend (Resend → API Keys; permissão "Sending access" basta).
RESEND_API_KEY=

# Remetente, num domínio VERIFICADO no Resend. Formato: Nome <endereço>.
INVITE_FROM=lanabiel <convite@email.ogabarbosa.com>

# Onde o app abre: o link do e-mail é `${APP_URL}/#convite=CODIGO`. Enquanto
# não houver deploy, `http://localhost:5173` (o link só funciona no seu Mac).
APP_URL=https://lanabiel.ogabarbosa.com
