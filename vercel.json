{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/mcp", "destination": "https://smdtcznadmnrdubeidyz.supabase.co/functions/v1/mcp?via=public" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "https://smdtcznadmnrdubeidyz.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource?via=public" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "https://smdtcznadmnrdubeidyz.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource?via=public" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
