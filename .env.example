# Copie para .env.local (ignorado pelo git via `*.local`).
#
# Stack local: `npx supabase start` imprime estes valores. As portas deste
# projeto foram movidas para 553xx porque outro projeto Supabase local já
# ocupa a faixa padrão 543xx — ver supabase/config.toml.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY da saída de `supabase start`>
